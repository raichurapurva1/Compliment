# Supabase project settings: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server only. Never expose this in the browser. Used to compute matches and run the seed script.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: turns on resume/LinkedIn PDF parsing and "Why you two?" explanations.
ANTHROPIC_API_KEY=

# Later: set to true once the providers are configured in Supabase (see README).
NEXT_PUBLIC_ENABLE_LINKEDIN=false
NEXT_PUBLIC_ENABLE_GOOGLE=false
